# 로컬 Claude Code CLI 사용 (API 키 불필요). `claude` 로 한 번 로그인해 두세요.
# 모델: opus / sonnet / haiku 별칭 또는 전체 모델명
HELPER_MODEL=opus
# 동시에 분석할 영상 수 (재생목록 처리 시). 늘리면 빨라지지만 Claude 사용량이 몰림
HELPER_CONCURRENCY=1
# 재생목록에서 가져올 최대 영상 수
HELPER_PLAYLIST_MAX=100
# claude 실행 파일이 PATH에 없으면 경로 지정
CLAUDE_CLI=
# 선택: ACRCloud 키를 넣으면 Shazam보다 먼저 사용
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
